{
  "manifest_version": 3,
  "name": "Hitokoto",
  "version": "0.1.0",
  "description": "選んだ語を AI が一言で説明する",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "options_page": "options.html"
}
